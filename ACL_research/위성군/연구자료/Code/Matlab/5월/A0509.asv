% ff_0 -> n 으로 변환
ff_0 = floor(ff_00/(86400/L)) - shift;
neg1 = ff_0;

gg_0 = floor(gg_00/(86400/L)) - shift;
neg2 = gg_0;

% length_ap = ff_0(1,2)-ff_0(1,1)+ff_0(2,2)-ff_0(2,1)+ff_0(3,2)-ff_0(3,1)+...
% +ff_0(4,2)-ff_0(4,1)+4;


% 구간의 시작점과 끝점을 변수에 저장
