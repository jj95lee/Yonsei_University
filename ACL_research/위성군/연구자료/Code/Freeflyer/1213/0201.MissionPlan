  <ProjectMissionSequence>
    <ProjectExternals />
    <ProjectCommands>
      <FreeForm enabled="true">
        <Label>Settings</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[																		// Array Setup
Array PointCoverage[0]; // Array to hold coverage statistics for each point
Array PointRevisit[0];  // Array to hold revisit statistics for each point
Array PointInView[0];   // Array to hold per sensor coverage indication for each point
Array Sensors;
Array OnOff[0];
Array latPointsInRegion[0];
Array lonPointsInRegion[0];
																		// Variable Setup
Variable CoverageChange;
Matrix nPlanes[2,3];
Variable nSCsPerPlane;
Matrix nSC[2,1];
Variable p;
Variable j;
Variable incrRAAN;
Variable f;
Variable i;                     // 1204 sim애서 추가 
Variable z;
Variable centerLat;             // 1204 sim애서 추가 
Variable centerLong;            // 1204 sim애서 추가 
Variable numberOfPointss;       // 1204 sim애서 추가 
String analysisStartEpochString;
TimeSpan analysisStartEpoch;
PointGroup coveragePointGroup; // 1204 sim애서 추가 
																		// GS setup
GroundStation GroundStation1;
GroundStation1.Latitude = 37.5642135;    //서울 위도 경도  //대전 위도,경도 36.35 127.38 
GroundStation1.Longitude = 127.269311;   
GroundStation1.Height = 0;
GroundStation1.MaskShape = "Cone"; // 빨간색 cone 
GroundStation1.ConeElevation = 90; // 빨간색 cone의 elevation
GroundStation1.Antenna.LimbLimit = 0; // 빨간색 cone
GroundStation1.Antenna.UseLimbLimit = 0; // 빨간색 cone,true = 1
analysisStartEpochString = "Jan 01 2024 00:00:00.000000000";
analysisStartEpoch = analysisStartEpochString.ParseCalendarDate();
																		// Walker-Delta Parameter 설정

																		// 대상 Region 설정 //
Region Region2;
Region2.NumberOfVertices = 4;
Region2.Latitude = {-1, -1, 1, 1};
Region2.Longitude = {-90, 90, 90, -90};

// Define the PointGroup based on the selected Region:
Define Procedure PopulatePointGroupBasedOnRegion(Region theRegion, PointGroup thePointGroup, Variable initialNumberOfPoints, Variable centerLatitude, Variable centerLongitude);

	// Procedure to setup a PointGroup based off a defined region
	
	// Object creation
	Variable i;
	Variable j;
	Variable maxLat = -90;
	Variable minLat = 90;
	Variable maxLon = 0;
	Variable minLon = 360;
	Variable lon;
	Variable lat;
	Variable prevLon;
	Variable prevLat;
	Variable lonSwitch;
	Variable latSwitch;
	Variable numOfPoints;
	Variable aspectRatio;
	Variable pointsAlongLon;
	Variable pointsAlongLat;
	Variable count;
	
	PointGroup boundingBoxPointGroup;
	
	Spacecraft sc;
	
	Array latPointsInRegion[0];
	Array lonPointsInRegion[0];

	//Block Determine bounding box for region
	
	For i = 0 to theRegion.NumberOfVertices-1;

		If (sign(theRegion.Latitude[i]) != sign(prevLat));
			If ((theRegion.Latitude[i] >= -90 and theRegion.Latitude[i] < -45) or
				(theRegion.Latitude[i] <= 90 and theRegion.Latitude[i] > 45));
				
				latSwitch = 1;
			Else;
				
				latSwitch = 0;
			End;
		End;			

		If (sign(theRegion.Longitude[i]) != sign(prevLon));
			If ((theRegion.Longitude[i] >= -180 and theRegion.Longitude[i] < -90) or
				(theRegion.Longitude[i] <= 180 and theRegion.Longitude[i] > 90));
				
				lonSwitch = 1;
			Else;
				
				lonSwitch = 0;
			End;
		End;			

		prevLat = theRegion.Latitude[i];
		prevLon = theRegion.Longitude[i];
		
		// If long switches signs around +/- 180, do this - otherwise do nothing
		If (lonSwitch == 1 and theRegion.Longitude[i] < 0);
			
			lon = theRegion.Longitude[i] + 360;
		Else;
			
			lon = theRegion.Longitude[i];
		End;

		// If lat switches signs around +/- 90, do this - otherwise do nothing
		If (latSwitch == 1 and theRegion.Latitude[i] < 0);
			
			lat = theRegion.Latitude[i];// + 90;
		Else;
			
			lat = theRegion.Latitude[i];
		End;

		If (lat < minLat);
			
			minLat = lat;
		End;

		If (lat > maxLat);
			
			maxLat = lat;
		End;

		If (lon < minLon);
			
			minLon = lon;
		End;

		If (lon > maxLon);
			
			maxLon = lon;
		End;
	End;
	
	// Cache the center lat/long of the bounding box:
	centerLatitude = ((maxLat + minLat)/2);
	centerLongitude = ((minLon + maxLon)/2);
	//EndBlock

	//Block Create PointGroup evenly spaced over bounding box

	// Create a PointGroup evenly spaced over max/min
	
	numOfPoints = initialNumberOfPoints;  // Not necessarily final number of points: Rectangle will be largest that preserves aspect ratio. Use at least 150 pts.
	aspectRatio = (maxLon - minLon)/(maxLat - minLat);      // Determine box size
	pointsAlongLon = round(sqrt(numOfPoints*aspectRatio));  // Calculate number of columns
	pointsAlongLat = round(pointsAlongLon/aspectRatio);     // Calculate number of rows

	// Calculate number of points
	count = (pointsAlongLat+1)*(pointsAlongLon+1);
	
	// Build rectangular PointGroup
	boundingBoxPointGroup.PointDefinition = 2;
	boundingBoxPointGroup.Count = count;
	count = 0;
	For i = minLat to maxLat step (maxLat - minLat)/pointsAlongLat;

		For j = minLon to maxLon step (maxLon - minLon)/pointsAlongLon;

			If (j > 360);
				
				j -= 360;
			End;
			If (i > 90);
				
				i -= 90;
			End;

			boundingBoxPointGroup[count].Longitude = j;
			boundingBoxPointGroup[count].Latitude = i;
			count++;
		End;
	End;
	//EndBlock

	//Block Define PointGroup in Region

	// Place a Spacecraft at each point and determine whether SC is In Region
	// If yes, add that point to latPointsInRegion and lonPointsInRegion Arrays

	For i = 0 to boundingBoxPointGroup.Count-1;

		// Assign Spacecraft location to current point of boundingBoxPointGroup
		sc.Latitude = boundingBoxPointGroup[i].Latitude;
		sc.Longitude = boundingBoxPointGroup[i].Longitude;

		// Check whether the current point is inside the Region
		If (sc.InRegion(theRegion) == 1);

			// If so, add point to Arrays
			latPointsInRegion.PushBack(boundingBoxPointGroup[i].Latitude);
			lonPointsInRegion.PushBack(boundingBoxPointGroup[i].Longitude);
		End;
	End;

	// Initialize the PointGroup with number of points determined above
	thePointGroup.PointDefinition = 2;
	thePointGroup.Count = latPointsInRegion.Dimension;

	// Add points in Arrays to thePointGroup
	For i = 0 to thePointGroup.Count-1;

		thePointGroup[i].Latitude = latPointsInRegion[i];
		thePointGroup[i].Longitude = lonPointsInRegion[i];
	End;
	
	// Return value for number of points
	initialNumberOfPoints = thePointGroup.NumberOfPoints;
	//EndBlock
EndProcedure;
numberOfPointss = 2601;
centerLat = 37.5642135;
centerLong = 127.0016985;
Call PopulatePointGroupBasedOnRegion(Region2, coveragePointGroup, numberOfPointss, centerLat, centerLong); // Call procedure to setup constellation]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Simulator</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[																// Walker-Delta 위성군 Design// 
Variable nSC_count;
Variable nPlanes_count;
Variable timespan_sec;

//nSC = [160;160];
//nPlanes = [4,4;4,4];
nSC = [30];
nPlanes = [3];


timespan_sec = 1; 																								//Stepsize

Formation scFormation; 																							// Create a Formation with nSC Spacecraft
scFormation.ViewAsGroup = 0;

For nSC_count = 0 to nSC.RowCount-1;
	For nPlanes_count = 0 to nPlanes.ColumnCount-1;
//		For f = 0 to nPlanes[nSC_count,nPlanes_count]-1;
		For f = 4 to 4;
			nSCsPerPlane = nSC[nSC_count,0] / nPlanes[nSC_count,nPlanes_count];
			scFormation.Count = nSC[nSC_count,0];
			For p = 0 to (nPlanes[nSC_count,nPlanes_count] - 1);
				incrRAAN = 360/nPlanes[nSC_count,nPlanes_count]*p ;
				For j = 0 to (nSCsPerPlane -1);
					 scFormation[p* nSCsPerPlane + j].Epoch = analysisStartEpoch;
					 scFormation[p* nSCsPerPlane + j].A = 6878; // 6378+500(위성 고도)        					// Increase the Semi-Major axis 50km for each Spacecraft in the Formation
					 scFormation[p* nSCsPerPlane + j].I = 40;                              						// Increase the inclination 10 degrees for each Spacecraft in the Formation
					 scFormation[p* nSCsPerPlane + j].RAAN = incrRAAN ;	
					 scFormation[p* nSCsPerPlane + j].E = 1e-7 ;	
					 scFormation[p* nSCsPerPlane + j].W = 0 ;	
					 scFormation[p* nSCsPerPlane + j].TA = 360/nSCsPerPlane * j + f * 360/(nSCsPerPlane*nPlanes[nSC_count,nPlanes_count])*p ;	
					 scFormation[p* nSCsPerPlane + j].AddSensor("sensor" + (p* nSCsPerPlane + j).ToString);     // Add a sensor to each Spacecraft in the Formation
					 //scFormation[p* nSCsPerPlane + j].SetPropagatorType(TypeOf(TwoBody));
					 scFormation[p* nSCsPerPlane + j].SetPropagatorType("TwoBody");
					
					 scFormation[p* nSCsPerPlane + j].Sensors[0].ConeHalfAngle = 20; 							// 노란색 cone 
					 scFormation[p* nSCsPerPlane + j].Sensors[0].Color = ColorTools.White;
					 scFormation[p* nSCsPerPlane + j].Sensors[0].Opacity = 0.1;
					 scFormation[p* nSCsPerPlane + j].Sensors[0].ProjectionHeight = 5000;
			 		 scFormation[p* nSCsPerPlane + j].Sensors[0].ZAxisAzimuth = 0;
					 scFormation[p* nSCsPerPlane + j].Sensors[0].ZAxisElevation = 0;
					 scFormation[p* nSCsPerPlane + j].Propagator.StepSize = TimeSpan.FromSeconds(timespan_sec);
					
					
					
					
					
				End;
				
			End;
																		// Simulate //
			While (scFormation[0].ElapsedTime < TIMESPAN(3 days));
				CoverageChange = coveragePointGroup.Coverage(scFormation,PointCoverage); 
					//Report PointCoverage to "nSC="+nSC[nSC_count,0].ToString.Format("%3.0f")+"_nPlanes="+nPlanes[nSC_count,nPlanes_count].ToString.Format("%1.0f")+"_f="+f.ToString.Format("%1.0f")+"_pointcoveragearray.txt";
			   		Report PointCoverage.Sum,coveragePointGroup.NumberOfPoints  to "nSC="+nSC[nSC_count,0].ToString.Format("%3.0f")+"_nPlanes="+nPlanes[nSC_count,nPlanes_count].ToString.Format("%1.0f")+"_f="+f.ToString.Format("%1.0f")+"_pointcoveragearray_kep_3day.txt";
				For i = 0 to coveragePointGroup.NumberOfPoints - 1;			// i = number of points  
					If (PointCoverage[i] == 1);                      		// 1 - Has been in view
					    coveragePointGroup.PointColor[i] = ColorTools.Blue;
					Else;
					    coveragePointGroup.PointColor[i] = ColorTools.Red;  // 0 - Never been in view
					End;
			   	    PointCoverage[i] = 0; 									// 위의 for문을 초기화 시켜서 계속 반복시키기위해 0으로 설정 
			    End;
		        For p = 0 to nSC[nSC_count,0]-1; 								// p = 위성의 번호(ex)위성 160개이면 0부터 160개까지)
			   		Report scFormation[p].Access(Region2) to "nSC="+nSC[nSC_count,0].ToString.Format("%3.0f")+"_nPlanes="+nPlanes[nSC_count,nPlanes_count].ToString.Format("%1.0f")+"_f="+f.ToString.Format("%1.0f")+"_AccessReport_kep_3day.txt"; // with sensor
				End;
				View scFormation,coveragePointGroup ;
			   	Step scFormation;
			End;
			scFormation.Clear();
		End;
	End;
End;
												// 위성 센서 회전용 코드 //
//	For p = 0 to nPlanes*nSCsPerPlane-1;
//	  A[0,p] = scFormation[p].TA;
//	  A[1,p] = scFormation[p].I;
//		If ( 49.2 <= GroundStation1.Elevation(scFormation[p])) ;
//				If ( GroundStation1.Elevation(scFormation[p])<62) ;
//			  	scFormation[p].Sensors[0].ZAxisAzimuth = scFormation[p].Azimuth(GroundStation1);
//				scFormation[p].Sensors[0].ZAxisElevation = scFormation[p].Elevation(GroundStation1);
//				scFormation[p].Sensors[0].Color = ColorTools.Red;
//				scFormation[p].Sensors[0].Opacity = 0.1;
//				Report GroundStation1.Elevation(scFormation[p]);
//				scFormation[p].Sensors[0].ZAxisAzimuth = 0;
//				scFormation[p].Sensors[0].ZAxisElevation = 0;
//				scFormation[p].Sensors[0].Color = ColorTools.Yellow;
//				ElseIf ( GroundStation1.Elevation(scFormation[p])>=62);
//				scFormation[p].Sensors[0].ZAxisAzimuth = 0;
//				scFormation[p].Sensors[0].ZAxisElevation = 0;
//				scFormation[p].Sensors[0].Color = ColorTools.Yellow;	
//				End;
//			// PID 제어를 통한 위성의 자세 제어 가능성 있음 
//		Else;
//			scFormation[p].Sensors[0].ZAxisAzimuth = 0;
//			scFormation[p].Sensors[0].ZAxisElevation = 0;
//			scFormation[p].Sensors[0].Color = ColorTools.Yellow;
//			
//		End;
//		Report scFormation[p].Access(GroundStation1) to "G_0_100sec_3days_AccessReport.txt"; // no sensor
//	End;]]></FreeFormScript>
      </FreeForm>
      <SaveCommand enabled="true">
        <Save name="Command3" isConstant="false" isGlobal="false">
          <Name>Command3</Name>
          <BaseObject>numberOfPoints</BaseObject>
          <SaveName>
            <StringConstant name="Command3_:SaveName" isConstant="false" isGlobal="false">
              <Name>Command3_:SaveName</Name>
              <value>SaveName</value>
              <metadata dim="0" />
            </StringConstant>
          </SaveName>
          <metadata dim="0" />
        </Save>
      </SaveCommand>
      <ReportCommand enabled="true">
        <Report name="Command4" isConstant="false" isGlobal="false">
          <Name>Command4</Name>
          <OutputType>File</OutputType>
          <OutputTypes>
            <File>
              <Filename>report.txt</Filename>
            </File>
          </OutputTypes>
          <Items dim="1">
            <value>
              <EventWithFormat name="Command4_:Items1" isConstant="false" isGlobal="false">
                <Name>Command4_:Items1</Name>
                <BaseObject>
                  <ObjectHolder name="Command4_:Items1_:BaseObject" isConstant="false" isGlobal="false">
                    <Name>Command4_:Items1_:BaseObject</Name>
                    <BaseObject>numberOfPoints</BaseObject>
                    <metadata dim="0" />
                  </ObjectHolder>
                </BaseObject>
                <Width units="" displayed_units="">14</Width>
                <Precision units="" displayed_units="">7</Precision>
                <metadata dim="0" />
              </EventWithFormat>
            </value>
          </Items>
          <WithoutHeaders>0</WithoutHeaders>
          <WithoutLinefeed>0</WithoutLinefeed>
          <WithoutPad>0</WithoutPad>
          <metadata dim="0" />
        </Report>
      </ReportCommand>
    </ProjectCommands>
  </ProjectMissionSequence>
  <ProjectScript><![CDATA[																		// Array Setup
Array PointCoverage[0]; // Array to hold coverage statistics for each point
Array PointRevisit[0];  // Array to hold revisit statistics for each point
Array PointInView[0];   // Array to hold per sensor coverage indication for each point
Array Sensors;
Array OnOff[0];
Array latPointsInRegion[0];
Array lonPointsInRegion[0];
																		// Variable Setup
Variable CoverageChange;
Matrix nPlanes[2,3];
Variable nSCsPerPlane;
Matrix nSC[2,1];
Variable p;
Variable j;
Variable incrRAAN;
Variable f;
Variable i;                     // 1204 sim애서 추가 
Variable z;
Variable centerLat;             // 1204 sim애서 추가 
Variable centerLong;            // 1204 sim애서 추가 
Variable numberOfPointss;       // 1204 sim애서 추가 
String analysisStartEpochString;
TimeSpan analysisStartEpoch;
PointGroup coveragePointGroup; // 1204 sim애서 추가 
																		// GS setup
GroundStation GroundStation1;
GroundStation1.Latitude = 37.5642135;    //서울 위도 경도  //대전 위도,경도 36.35 127.38 
GroundStation1.Longitude = 127.269311;   
GroundStation1.Height = 0;
GroundStation1.MaskShape = "Cone"; // 빨간색 cone 
GroundStation1.ConeElevation = 90; // 빨간색 cone의 elevation
GroundStation1.Antenna.LimbLimit = 0; // 빨간색 cone
GroundStation1.Antenna.UseLimbLimit = 0; // 빨간색 cone,true = 1
analysisStartEpochString = "Jan 01 2024 00:00:00.000000000";
analysisStartEpoch = analysisStartEpochString.ParseCalendarDate();
																		// Walker-Delta Parameter 설정

																		// 대상 Region 설정 //
Region Region2;
Region2.NumberOfVertices = 4;
Region2.Latitude = {-1, -1, 1, 1};
Region2.Longitude = {-90, 90, 90, -90};

// Define the PointGroup based on the selected Region:
Define Procedure PopulatePointGroupBasedOnRegion(Region theRegion, PointGroup thePointGroup, Variable initialNumberOfPoints, Variable centerLatitude, Variable centerLongitude);

	// Procedure to setup a PointGroup based off a defined region
	
	// Object creation
	Variable i;
	Variable j;
	Variable maxLat = -90;
	Variable minLat = 90;
	Variable maxLon = 0;
	Variable minLon = 360;
	Variable lon;
	Variable lat;
	Variable prevLon;
	Variable prevLat;
	Variable lonSwitch;
	Variable latSwitch;
	Variable numOfPoints;
	Variable aspectRatio;
	Variable pointsAlongLon;
	Variable pointsAlongLat;
	Variable count;
	
	PointGroup boundingBoxPointGroup;
	
	Spacecraft sc;
	
	Array latPointsInRegion[0];
	Array lonPointsInRegion[0];

	//Block Determine bounding box for region
	
	For i = 0 to theRegion.NumberOfVertices-1;

		If (sign(theRegion.Latitude[i]) != sign(prevLat));
			If ((theRegion.Latitude[i] >= -90 and theRegion.Latitude[i] < -45) or
				(theRegion.Latitude[i] <= 90 and theRegion.Latitude[i] > 45));
				
				latSwitch = 1;
			Else;
				
				latSwitch = 0;
			End;
		End;			

		If (sign(theRegion.Longitude[i]) != sign(prevLon));
			If ((theRegion.Longitude[i] >= -180 and theRegion.Longitude[i] < -90) or
				(theRegion.Longitude[i] <= 180 and theRegion.Longitude[i] > 90));
				
				lonSwitch = 1;
			Else;
				
				lonSwitch = 0;
			End;
		End;			

		prevLat = theRegion.Latitude[i];
		prevLon = theRegion.Longitude[i];
		
		// If long switches signs around +/- 180, do this - otherwise do nothing
		If (lonSwitch == 1 and theRegion.Longitude[i] < 0);
			
			lon = theRegion.Longitude[i] + 360;
		Else;
			
			lon = theRegion.Longitude[i];
		End;

		// If lat switches signs around +/- 90, do this - otherwise do nothing
		If (latSwitch == 1 and theRegion.Latitude[i] < 0);
			
			lat = theRegion.Latitude[i];// + 90;
		Else;
			
			lat = theRegion.Latitude[i];
		End;

		If (lat < minLat);
			
			minLat = lat;
		End;

		If (lat > maxLat);
			
			maxLat = lat;
		End;

		If (lon < minLon);
			
			minLon = lon;
		End;

		If (lon > maxLon);
			
			maxLon = lon;
		End;
	End;
	
	// Cache the center lat/long of the bounding box:
	centerLatitude = ((maxLat + minLat)/2);
	centerLongitude = ((minLon + maxLon)/2);
	//EndBlock

	//Block Create PointGroup evenly spaced over bounding box

	// Create a PointGroup evenly spaced over max/min
	
	numOfPoints = initialNumberOfPoints;  // Not necessarily final number of points: Rectangle will be largest that preserves aspect ratio. Use at least 150 pts.
	aspectRatio = (maxLon - minLon)/(maxLat - minLat);      // Determine box size
	pointsAlongLon = round(sqrt(numOfPoints*aspectRatio));  // Calculate number of columns
	pointsAlongLat = round(pointsAlongLon/aspectRatio);     // Calculate number of rows

	// Calculate number of points
	count = (pointsAlongLat+1)*(pointsAlongLon+1);
	
	// Build rectangular PointGroup
	boundingBoxPointGroup.PointDefinition = 2;
	boundingBoxPointGroup.Count = count;
	count = 0;
	For i = minLat to maxLat step (maxLat - minLat)/pointsAlongLat;

		For j = minLon to maxLon step (maxLon - minLon)/pointsAlongLon;

			If (j > 360);
				
				j -= 360;
			End;
			If (i > 90);
				
				i -= 90;
			End;

			boundingBoxPointGroup[count].Longitude = j;
			boundingBoxPointGroup[count].Latitude = i;
			count++;
		End;
	End;
	//EndBlock

	//Block Define PointGroup in Region

	// Place a Spacecraft at each point and determine whether SC is In Region
	// If yes, add that point to latPointsInRegion and lonPointsInRegion Arrays

	For i = 0 to boundingBoxPointGroup.Count-1;

		// Assign Spacecraft location to current point of boundingBoxPointGroup
		sc.Latitude = boundingBoxPointGroup[i].Latitude;
		sc.Longitude = boundingBoxPointGroup[i].Longitude;

		// Check whether the current point is inside the Region
		If (sc.InRegion(theRegion) == 1);

			// If so, add point to Arrays
			latPointsInRegion.PushBack(boundingBoxPointGroup[i].Latitude);
			lonPointsInRegion.PushBack(boundingBoxPointGroup[i].Longitude);
		End;
	End;

	// Initialize the PointGroup with number of points determined above
	thePointGroup.PointDefinition = 2;
	thePointGroup.Count = latPointsInRegion.Dimension;

	// Add points in Arrays to thePointGroup
	For i = 0 to thePointGroup.Count-1;

		thePointGroup[i].Latitude = latPointsInRegion[i];
		thePointGroup[i].Longitude = lonPointsInRegion[i];
	End;
	
	// Return value for number of points
	initialNumberOfPoints = thePointGroup.NumberOfPoints;
	//EndBlock
EndProcedure;
numberOfPointss = 2601;
centerLat = 37.5642135;
centerLong = 127.0016985;
Call PopulatePointGroupBasedOnRegion(Region2, coveragePointGroup, numberOfPointss, centerLat, centerLong); // Call procedure to setup constellation
																// Walker-Delta 위성군 Design// 
Variable nSC_count;
Variable nPlanes_count;
Variable timespan_sec;

//nSC = [160;160];
//nPlanes = [4,4;4,4];
nSC = [30];
nPlanes = [3];


timespan_sec = 1; 																								//Stepsize

Formation scFormation; 																							// Create a Formation with nSC Spacecraft
scFormation.ViewAsGroup = 0;

For nSC_count = 0 to nSC.RowCount-1;
	For nPlanes_count = 0 to nPlanes.ColumnCount-1;
//		For f = 0 to nPlanes[nSC_count,nPlanes_count]-1;
		For f = 4 to 4;
			nSCsPerPlane = nSC[nSC_count,0] / nPlanes[nSC_count,nPlanes_count];
			scFormation.Count = nSC[nSC_count,0];
			For p = 0 to (nPlanes[nSC_count,nPlanes_count] - 1);
				incrRAAN = 360/nPlanes[nSC_count,nPlanes_count]*p ;
				For j = 0 to (nSCsPerPlane -1);
					 scFormation[p* nSCsPerPlane + j].Epoch = analysisStartEpoch;
					 scFormation[p* nSCsPerPlane + j].A = 6878; // 6378+500(위성 고도)        					// Increase the Semi-Major axis 50km for each Spacecraft in the Formation
					 scFormation[p* nSCsPerPlane + j].I = 40;                              						// Increase the inclination 10 degrees for each Spacecraft in the Formation
					 scFormation[p* nSCsPerPlane + j].RAAN = incrRAAN ;	
					 scFormation[p* nSCsPerPlane + j].E = 1e-7 ;	
					 scFormation[p* nSCsPerPlane + j].W = 0 ;	
					 scFormation[p* nSCsPerPlane + j].TA = 360/nSCsPerPlane * j + f * 360/(nSCsPerPlane*nPlanes[nSC_count,nPlanes_count])*p ;	
					 scFormation[p* nSCsPerPlane + j].AddSensor("sensor" + (p* nSCsPerPlane + j).ToString);     // Add a sensor to each Spacecraft in the Formation
					 //scFormation[p* nSCsPerPlane + j].SetPropagatorType(TypeOf(TwoBody));
					 scFormation[p* nSCsPerPlane + j].SetPropagatorType("TwoBody");
					
					 scFormation[p* nSCsPerPlane + j].Sensors[0].ConeHalfAngle = 20; 							// 노란색 cone 
					 scFormation[p* nSCsPerPlane + j].Sensors[0].Color = ColorTools.White;
					 scFormation[p* nSCsPerPlane + j].Sensors[0].Opacity = 0.1;
					 scFormation[p* nSCsPerPlane + j].Sensors[0].ProjectionHeight = 5000;
			 		 scFormation[p* nSCsPerPlane + j].Sensors[0].ZAxisAzimuth = 0;
					 scFormation[p* nSCsPerPlane + j].Sensors[0].ZAxisElevation = 0;
					 scFormation[p* nSCsPerPlane + j].Propagator.StepSize = TimeSpan.FromSeconds(timespan_sec);
					
					
					
					
					
				End;
				
			End;
																		// Simulate //
			While (scFormation[0].ElapsedTime < TIMESPAN(3 days));
				CoverageChange = coveragePointGroup.Coverage(scFormation,PointCoverage); 
					//Report PointCoverage to "nSC="+nSC[nSC_count,0].ToString.Format("%3.0f")+"_nPlanes="+nPlanes[nSC_count,nPlanes_count].ToString.Format("%1.0f")+"_f="+f.ToString.Format("%1.0f")+"_pointcoveragearray.txt";
			   		Report PointCoverage.Sum,coveragePointGroup.NumberOfPoints  to "nSC="+nSC[nSC_count,0].ToString.Format("%3.0f")+"_nPlanes="+nPlanes[nSC_count,nPlanes_count].ToString.Format("%1.0f")+"_f="+f.ToString.Format("%1.0f")+"_pointcoveragearray_kep_3day.txt";
				For i = 0 to coveragePointGroup.NumberOfPoints - 1;			// i = number of points  
					If (PointCoverage[i] == 1);                      		// 1 - Has been in view
					    coveragePointGroup.PointColor[i] = ColorTools.Blue;
					Else;
					    coveragePointGroup.PointColor[i] = ColorTools.Red;  // 0 - Never been in view
					End;
			   	    PointCoverage[i] = 0; 									// 위의 for문을 초기화 시켜서 계속 반복시키기위해 0으로 설정 
			    End;
		        For p = 0 to nSC[nSC_count,0]-1; 								// p = 위성의 번호(ex)위성 160개이면 0부터 160개까지)
			   		Report scFormation[p].Access(Region2) to "nSC="+nSC[nSC_count,0].ToString.Format("%3.0f")+"_nPlanes="+nPlanes[nSC_count,nPlanes_count].ToString.Format("%1.0f")+"_f="+f.ToString.Format("%1.0f")+"_AccessReport_kep_3day.txt"; // with sensor
				End;
				View scFormation,coveragePointGroup ;
			   	Step scFormation;
			End;
			scFormation.Clear();
		End;
	End;
End;
												// 위성 센서 회전용 코드 //
//	For p = 0 to nPlanes*nSCsPerPlane-1;
//	  A[0,p] = scFormation[p].TA;
//	  A[1,p] = scFormation[p].I;
//		If ( 49.2 <= GroundStation1.Elevation(scFormation[p])) ;
//				If ( GroundStation1.Elevation(scFormation[p])<62) ;
//			  	scFormation[p].Sensors[0].ZAxisAzimuth = scFormation[p].Azimuth(GroundStation1);
//				scFormation[p].Sensors[0].ZAxisElevation = scFormation[p].Elevation(GroundStation1);
//				scFormation[p].Sensors[0].Color = ColorTools.Red;
//				scFormation[p].Sensors[0].Opacity = 0.1;
//				Report GroundStation1.Elevation(scFormation[p]);
//				scFormation[p].Sensors[0].ZAxisAzimuth = 0;
//				scFormation[p].Sensors[0].ZAxisElevation = 0;
//				scFormation[p].Sensors[0].Color = ColorTools.Yellow;
//				ElseIf ( GroundStation1.Elevation(scFormation[p])>=62);
//				scFormation[p].Sensors[0].ZAxisAzimuth = 0;
//				scFormation[p].Sensors[0].ZAxisElevation = 0;
//				scFormation[p].Sensors[0].Color = ColorTools.Yellow;	
//				End;
//			// PID 제어를 통한 위성의 자세 제어 가능성 있음 
//		Else;
//			scFormation[p].Sensors[0].ZAxisAzimuth = 0;
//			scFormation[p].Sensors[0].ZAxisElevation = 0;
//			scFormation[p].Sensors[0].Color = ColorTools.Yellow;
//			
//		End;
//		Report scFormation[p].Access(GroundStation1) to "G_0_100sec_3days_AccessReport.txt"; // no sensor
//	End;
Save numberOfPoints as "SaveName";
Report numberOfPoints<14,7> to "report.txt";]]></ProjectScript>
  <ProjectNotes></ProjectNotes>
</FreeFlyerProjectFile>