    <ProjectCommands>
      <FreeForm enabled="true">
        <Label>FreeForm</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[Array PointCoverage[0]; // Array to hold coverage statistics for each point

Array PointRevisit[0];  // Array to hold revisit statistics for each point

Array PointInView[0];   // Array to hold per sensor coverage indication for each point
Array Sensors;
Array OnOff[0];

Variable CoverageChange;
Variable nPlanes;
Variable nSCsPerPlane;
Variable nSC;
Variable p;
Variable j;
Variable incrRAAN;
Variable f;
String analysisStartEpochString;
TimeSpan analysisStartEpoch;


GroundStation GroundStation1;
GroundStation1.Latitude = 36.32;
GroundStation1.Longitude = 127.37;
GroundStation1.Height = 0;
GroundStation1.MaskShape = "Cone";
GroundStation1.ConeElevation = 56;
GroundStation1.Antenna.LimbLimit = 52;
GroundStation1.Antenna.UseLimbLimit = 1;

analysisStartEpochString = "Jan 01 2024 00:00:00.000000000";
analysisStartEpoch = analysisStartEpochString.ParseCalendarDate();

      // Change value to match analysis requirements
      
      // Define initial Epoch for the Walker constellation, can be changed in UI
// 궤도 평면 숫자 및 궤도 당 운용 위성 개수 지정//
nPlanes = 5;
nSCsPerPlane = 32; 
nSC = nPlanes * nSCsPerPlane;
 Matrix A[2,nSC];
// Create a Formation with nSC Spacecraft
Formation scFormation[nSC];
scFormation.ViewAsGroup = 0;

// Force Model 변경 //
ForceModel Forcemodel1;
Forcemodel1.Earth = 1;
Forcemodel1.PlanetFieldType[2] = 0 ;
Forcemodel1.AtmosphericDensityModel = 1;
Forcemodel1.SRP = 0;
Forcemodel1.SRPForceGeometry = 0;
Forcemodel1.Sun = 0;
Forcemodel1.Moon = 0;

//TwoBody myTwoBody1 (Forcemodel1);


// Walker-Delta 위성군 Design// 
f=0; //Change
For p = 0 to (nPlanes - 1);
	incrRAAN = 360 * (p / nPlanes) ;
	For j = 0 to (nSCsPerPlane -1);
		 scFormation[p* nSCsPerPlane + j].Epoch = analysisStartEpoch;
		 scFormation[p* nSCsPerPlane + j].A = 7578;                                 // Increase the Semi-Major axis 50km for each Spacecraft in the Formation
		 scFormation[p* nSCsPerPlane + j].I = 37;                                // Increase the inclination 10 degrees for each Spacecraft in the Formation
		 scFormation[p* nSCsPerPlane + j].RAAN = incrRAAN ;	
		 scFormation[p* nSCsPerPlane + j].E = 0 ;	
		 scFormation[p* nSCsPerPlane + j].W = 0 ;	
		 scFormation[p* nSCsPerPlane + j].TA = 360/nSCsPerPlane * j + f * 360/(nSCsPerPlane*nPlanes)*p ;	
		 scFormation[p* nSCsPerPlane + j].AddSensor("sensor" + (p* nSCsPerPlane + j).ToString);        // Add a sensor to each Spacecraft in the Formation
		 scFormation[p* nSCsPerPlane + j].SetPropagatorType("TwoBody");
		 scFormation[p* nSCsPerPlane + j].Sensors[0].ConeHalfAngle = 28;
		 scFormation[p* nSCsPerPlane + j].Sensors[0].Color = ColorTools.Yellow;
		 scFormation[p* nSCsPerPlane + j].Propagator.StepSize = TimeSpan.FromSeconds(100);
	End;
End;
String VV;
// Simulate //
While (scFormation[0].ElapsedTime < TIMESPAN(2 days));

       CoverageChange = PointGroup1.Coverage(scFormation,PointCoverage,PointRevisit,PointInView); 
//      If (CoverageChange == 1);
//
//            For p = 0 to PointGroup1.NumberOfPoints - 1;
//
//                  If (PointCoverage[p] == 1);                        // 1 - Has been in view
//
//                        PointGroup1.PointColor[p] = ColorTools.Lime;
//
//                  Else;
//
//                  	
//                        PointGroup1.PointColor[p] = ColorTools.Red;  // 0 - Never been in view
//
//                  End;
//
//            End;
//
//      End;
	
	For p = 0 to nPlanes*nSCsPerPlane-1;
	  Report scFormation[p].Access(GroundStation1) to "0_100sec_2days_i37__p5_AccessReport.txt";
	  A[0,p] = scFormation[p].TA;
	  A[1,p] = scFormation[p].I;
	End;
      //View scFormation, PointGroup1,Formation1,GroundStation1;
	

	Step scFormation;
 	//Report PointRevisit to "0.00100.txt";
	//Report Forcemodel1.PlanetFieldType to "Force.txt";
	//Report Forcemodel1.PlanetFieldDegree to "Degree.txt";
	//Report Forcemodel1.PlanetFieldOrder to "Order.txt";
	//Report Forcemodel1.Drag to "Drag.txt";
	//Report Forcemodel1.Lift to "Lift.txt";
	//Report Forcemodel1.AtmosphericDensityModel to "AtmosphericDensityModel.txt";
	//Report Forcemodel1.SRPForceGeometry to "SRPForceGeometry.txt"; 
	//Report PointRevisit[0] to "Point.txt";
	
	VV = "TA at" +" "+ scFormation[0].ElapsedTime.ToString.Format("%5.1f");
	Report VV,A[0,:];
	Report VV,A[1,:];
End;

]]></FreeFormScript>
      </FreeForm>
      <SaveCommand enabled="true">
        <Save name="Command2" isConstant="false" isGlobal="false">
          <Name>Command2</Name>
          <BaseObject>numberOfPoints</BaseObject>
          <SaveName>
            <StringConstant name="Command2_:SaveName" isConstant="false" isGlobal="false">
              <Name>Command2_:SaveName</Name>
              <value>SaveName</value>
              <metadata dim="0" />
            </StringConstant>
          </SaveName>
          <metadata dim="0" />
        </Save>
      </SaveCommand>
      <ReportCommand enabled="true">
        <Report name="Command3" isConstant="false" isGlobal="false">
          <Name>Command3</Name>
          <OutputType>File</OutputType>
          <OutputTypes>
            <File>
              <Filename>report.txt</Filename>
            </File>
          </OutputTypes>
          <Items dim="1">
            <value>
              <EventWithFormat name="Command3_:Items1" isConstant="false" isGlobal="false">
                <Name>Command3_:Items1</Name>
                <BaseObject>
                  <ObjectHolder name="Command3_:Items1_:BaseObject" isConstant="false" isGlobal="false">
                    <Name>Command3_:Items1_:BaseObject</Name>
                    <BaseObject>numberOfPoints</BaseObject>
                    <metadata dim="0" />
                  </ObjectHolder>
                </BaseObject>
                <Width units="" displayed_units="">14</Width>
                <Precision units="" displayed_units="">7</Precision>
                <metadata dim="0" />
              </EventWithFormat>
            </value>
          </Items>
          <WithoutHeaders>0</WithoutHeaders>
          <WithoutLinefeed>0</WithoutLinefeed>
          <WithoutPad>0</WithoutPad>
          <metadata dim="0" />
        </Report>
      </ReportCommand>
    </ProjectCommands>
  </ProjectMissionSequence>
  <ProjectScript><![CDATA[Array PointCoverage[0]; // Array to hold coverage statistics for each point

Array PointRevisit[0];  // Array to hold revisit statistics for each point

Array PointInView[0];   // Array to hold per sensor coverage indication for each point
Array Sensors;
